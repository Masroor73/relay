# Local dev (Docker Compose): postgres://relay:relay_dev_only@localhost:5432/relay
# Staging/prod: Neon connection string, unmodified by the app — same var, different value per environment.
DATABASE_URL=postgres://relay:relay_dev_only@localhost:5432/relay

# Stripe webhook signing secret used to verify inbound signatures.
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# Shared password gating dashboard access (public portfolio deployment).
# Not yet read by the app — reserved for Milestone 4 (dashboard auth).
DASHBOARD_PASSWORD=change_me
